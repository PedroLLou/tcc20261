# Copy only for reference. Generate local secrets with:
# node scripts/create-container-env.mjs
WEB_PORT=8080
POSTGRES_DB=tcc
POSTGRES_USER=tcc
POSTGRES_PASSWORD=
DATABASE_URL=
# Conexão das migrações (dono do banco). No banco local do Compose, igual à DATABASE_URL.
DIRECT_URL=
JWT_SECRET=
DEFAULT_ADMIN_RH_EMAIL=admin@example.invalid
DEFAULT_ADMIN_RH_PASSWORD=

# Same-origin local NGINX needs no CORS. Render static frontend needs its exact origin.
CORS_ORIGINS=
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=tcc20261-api
APP_RELEASE=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
OTEL_TRACES_SAMPLER_ARG=0.1

# Empty endpoint keeps remote export disabled. Store real ingestion keys only in .env.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
