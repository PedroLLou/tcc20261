# Preferir: node scripts/create-container-env.mjs
# Os valores vazios são obrigatórios; Compose recusa iniciar sem eles.
WEB_PORT=8080
POSTGRES_DB=tcc
POSTGRES_USER=tcc
POSTGRES_PASSWORD=
# Usar a mesma senha acima, com caracteres especiais codificados para URL.
DATABASE_URL=
# Conexão das migrações (dono do banco). No banco local do Compose, igual à DATABASE_URL.
DIRECT_URL=
JWT_SECRET=
DEFAULT_ADMIN_RH_EMAIL=admin@example.invalid
DEFAULT_ADMIN_RH_PASSWORD=
