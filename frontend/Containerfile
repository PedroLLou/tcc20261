ARG NODE_IMAGE=docker.io/library/node:24-bookworm-slim
ARG WEB_IMAGE=docker.io/nginxinc/nginx-unprivileged:1.30-alpine
FROM ${NODE_IMAGE} AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM dependencies AS test
COPY tsconfig.json .eslintrc.js ./
COPY public ./public
COPY src ./src
COPY tests ./tests
ENV CI=true
CMD ["sh", "-c", "node --test --test-isolation=none tests/api.test.mjs && npm test -- --watchAll=false --runInBand"]

FROM test AS build
# O workflow existente usa CI=false durante o build do CRA.
ENV CI=false
ARG REACT_APP_API_URL=/api/v1
ENV REACT_APP_API_URL=${REACT_APP_API_URL}
ENV GENERATE_SOURCEMAP=false
RUN npm run build

FROM ${WEB_IMAGE} AS runtime
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
ENV NGINX_ENVSUBST_OUTPUT_DIR=/tmp
ENV NGINX_ENVSUBST_FILTER="^(NGINX_LOCAL_RESOLVERS|PORT|API_UPSTREAM_SCHEME|API_UPSTREAM_HOST|API_UPSTREAM_PORT)$"
ENV PORT=8080
ENV API_UPSTREAM_SCHEME=http
ENV API_UPSTREAM_HOST=api
ENV API_UPSTREAM_PORT=3001
COPY nginx.conf /etc/nginx/nginx.conf
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 8080
