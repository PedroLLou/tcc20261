generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN_LEADER    // Líder de equipe
  TEAM_MEMBER     // Membro da equipe
  ADMIN_RH        // Admin de RH da empresa
}

enum FeedbackProcessStatus {
  DRAFT
  SENT_FOR_VALIDATION
  PLANNED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  age       Int
  email     String   @unique
  password  String
  role      UserRole @default(TEAM_MEMBER)
  teamId    Int?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedFeedbackProcesses FeedbackProcess[] @relation("FeedbackProcessOwner")
  receivedFeedbackProcesses FeedbackProcess[] @relation("FeedbackProcessParticipant")
  @@index([teamId])
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model FeedbackProcess {
  id            Int                   @id @default(autoincrement())
  description   String?
  objective     String                @default("")
  startsAt      DateTime?
  endsAt        DateTime?
  criteria      String[]              @default([])
  observation   String?
  status        FeedbackProcessStatus @default(DRAFT)
  ownerId       Int
  owner         User                  @relation("FeedbackProcessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participantId Int?
  participant   User?                 @relation("FeedbackProcessParticipant", fields: [participantId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([ownerId])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Auditoria (não-repúdio)
//
// Os registros são gravados exclusivamente por triggers do PostgreSQL
// (função audit_record_change), na mesma transação da operação auditada.
// A aplicação apenas informa quem está operando, por meio de configurações
// locais da transação (ver src/prisma-audit.extension.ts).
//
// Não há chave estrangeira para User de propósito: o histórico precisa
// sobreviver à exclusão do usuário que realizou a operação.
// ---------------------------------------------------------------------------

enum AuditOperation {
  INSERT
  UPDATE
  DELETE
}

enum AuditSource {
  APPLICATION // operação feita pela API, com o usuário autenticado (quando houver)
  DATABASE // operação feita direto no banco (pgAdmin, psql etc.)
}

model AuditLog {
  id            Int            @id @default(autoincrement())
  operation     AuditOperation
  tableName     String
  recordId      String
  oldData       Json?
  newData       Json?
  actorId       Int?
  actorEmail    String?
  source        AuditSource
  dbUser        String
  clientIp      String?
  request       String?
  transactionId BigInt
  createdAt     DateTime       @default(now())

  @@index([tableName, recordId])
  @@index([actorId])
  @@index([createdAt])
}
