ARG NODE_IMAGE=docker.io/library/node:24-trixie-slim
ARG RUNTIME_IMAGE=gcr.io/distroless/nodejs24-debian13:nonroot
FROM ${NODE_IMAGE} AS base
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

FROM base AS dependencies
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm ci --no-audit --no-fund
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build \
    ./node_modules/.bin/prisma generate

FROM dependencies AS test
COPY tsconfig*.json nest-cli.json ./
COPY src ./src
CMD ["npm", "test", "--", "--runInBand"]

FROM test AS build
RUN npm run build && test -f dist/src/main.js && test -f dist/src/observability/instrumentation.js

FROM dependencies AS production-dependencies
RUN npm prune --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund \
    && find node_modules -type f \( -name '*.map' -o -name '*.d.ts' -o -name '*.d.mts' -o -name '*.d.cts' \) -delete \
    && test ! -d node_modules/prisma \
    && test ! -d node_modules/typescript \
    && node -e "require('dotenv/config'); require('@prisma/client'); require('bcrypt')"

FROM dependencies AS migration-dependencies
# O migrador precisa só do CLI e dotenv, nas versões já instaladas pelo lockfile.
RUN prisma_version=$(node -p "require('./node_modules/prisma/package.json').version") \
    && dotenv_version=$(node -p "require('./node_modules/dotenv/package.json').version") \
    && npm pkg delete dependencies devDependencies \
    && npm pkg set "dependencies.prisma=$prisma_version" "dependencies.dotenv=$dotenv_version" \
    && npm prune --omit=dev --omit=optional --ignore-scripts --offline --no-audit --no-fund \
    && test -x node_modules/.bin/prisma

FROM base AS migration
ENV NODE_ENV=production
COPY --from=migration-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node prisma ./prisma
COPY --chown=node:node prisma.config.ts package.json package-lock.json ./
USER node
CMD ["./node_modules/.bin/prisma", "migrate", "deploy"]

FROM base AS runtime-slim
ENV NODE_ENV=production
COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
USER node
EXPOSE 3001
CMD ["node", "--require", "dotenv/config", "--require", "./dist/src/observability/instrumentation.js", "dist/src/main.js"]

FROM base AS runtime-libraries
# Copiar o arquivo real, sem fixar a arquitetura no caminho multiarch Debian.
RUN mkdir /runtime-libs && cp /usr/lib/*-linux-gnu/libz.so.1 /runtime-libs/libz.so.1

FROM ${RUNTIME_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PATH="/nodejs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
COPY --from=runtime-libraries /runtime-libs/libz.so.1 /usr/lib/libz.so.1
COPY --from=production-dependencies --chown=65532:65532 /app/node_modules ./node_modules
COPY --from=build --chown=65532:65532 /app/dist ./dist
USER 65532:65532
EXPOSE 3001
CMD ["--require", "dotenv/config", "--require", "./dist/src/observability/instrumentation.js", "dist/src/main.js"]
