# Copie para backend/.env e preencha. Nunca versione o .env real.
# Detalhes em docs/banco-de-dados.md.

# Conexão da API: usuário com privilégios mínimos (tcc_app).
# No Neon, usar o endereço com "-pooler" no host.
DATABASE_URL="postgresql://tcc_app:SENHA@HOST-pooler/tcc?sslmode=require&channel_binding=require"

# Conexão das migrações (Prisma Migrate): dono do banco (tcc_owner).
# No Neon, usar o endereço direto (sem "-pooler").
# Em um PostgreSQL local com um único usuário, pode ser igual à DATABASE_URL.
DIRECT_URL="postgresql://tcc_owner:SENHA@HOST/tcc?sslmode=require&channel_binding=require"

# Segredo para assinar os tokens JWT (obrigatório; use um valor longo e aleatório).
JWT_SECRET=

# Administrador RH criado na primeira inicialização, se ainda não houver nenhum.
DEFAULT_ADMIN_RH_EMAIL=
DEFAULT_ADMIN_RH_PASSWORD=

# Porta da API (padrão: 3001).
# PORT=3001
