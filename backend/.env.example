# Copie para backend/.env e preencha. Nunca commite o .env real.

# Postgres usado pelo Prisma
DATABASE_URL="postgresql://usuario:senha@localhost:5432/tcc?schema=public"

# Segredo para assinar os tokens JWT
JWT_SECRET=

# Admin RH criado no startup se não existir nenhum (opcional; há valores padrão)
DEFAULT_ADMIN_RH_EMAIL=
DEFAULT_ADMIN_RH_PASSWORD=
